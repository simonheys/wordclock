{
  "name": "@simonheys/wordclock",
  "version": "1.2.0",
  "private": false,
  "type": "module",
  "author": "Simon Heys <si@simonheys.com>",
  "license": "MIT",
  "main": "./dist/wordclock.cjs",
  "module": "./dist/wordclock.js",
  "types": "./dist/wordclock.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/wordclock.d.ts",
      "import": "./dist/wordclock.js",
      "require": "./dist/wordclock.cjs",
      "default": "./dist/wordclock.js"
    }
  },
  "dependencies": {
    "@simonheys/wordclock-words": "*",
    "resize-observer-polyfill": "1.5.1"
  },
  "devDependencies": {
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/github": "12.0.2",
    "@semantic-release/npm": "13.1.3",
    "@semantic-release/release-notes-generator": "14.1.0",
    "@simonheys/eslint-config": "workspace:*",
    "@simonheys/typescript-config": "workspace:*",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "8.50.0",
    "@typescript-eslint/parser": "8.50.0",
    "@vitejs/plugin-react-swc": "4.3.0",
    "concurrently": "9.2.1",
    "eslint": "9.39.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "happy-dom": "20.9.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "semantic-release": "25.0.2",
    "typescript": "5.9.3",
    "vite": "7.3.0",
    "vite-plugin-dts": "4.5.4",
    "vitest": "4.1.5"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "scripts": {
    "build": "vite build",
    "build:watch": "vite build --watch",
    "dev": "concurrently \"pnpm build:watch\" \"pnpm dev:example\"",
    "dev:example": "cd example && pnpm dev",
    "publish-npm": "pnpm build && npm publish --access public",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --ignore-unknown --write .",
    "format:check": "prettier --ignore-unknown --check ."
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "description": "Simple react component that can run in a web browser",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simonheys/wordclock.git"
  },
  "keywords": [
    "wordclock"
  ],
  "bugs": {
    "url": "https://github.com/simonheys/wordclock/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/simonheys/wordclock#readme"
}
