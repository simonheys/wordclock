{
  "name": "@wordclock/react",
  "version": "1.2.0",
  "private": false,
  "description": "Simple react component that can run in a web browser",
  "keywords": [
    "wordclock"
  ],
  "homepage": "https://github.com/simonheys/wordclock#readme",
  "bugs": {
    "url": "https://github.com/simonheys/wordclock/issues"
  },
  "license": "MIT",
  "author": "Simon Heys <si@simonheys.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simonheys/wordclock.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm,cjs --dts --platform neutral",
    "build:watch": "pnpm build --watch",
    "dev": "concurrently \"pnpm build:watch\" \"pnpm dev:example\"",
    "dev:example": "cd example && pnpm dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@wordclock/canvas": "^0.1.0"
  },
  "devDependencies": {
    "@simonheys/typescript-config": "1.0.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "concurrently": "9.2.1",
    "happy-dom": "20.9.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsdown": "0.22.14",
    "typescript": "7.0.2",
    "vite": "8.0.14",
    "vitest": "4.1.7"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
