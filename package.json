{
  "name": "wordclock",
  "version": "1.2.1",
  "private": true,
  "license": "MIT",
  "author": "Simon Heys <si@simonheys.com>",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "format": "oxfmt . && turbo run format",
    "format:check": "oxfmt --check .",
    "build": "turbo run build --filter='!wordclock-macos'",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix --deny-warnings .",
    "typecheck": "turbo run typecheck",
    "test": "CI=true turbo run test --filter='!wordclock-macos'",
    "dev": "turbo run dev",
    "prepare": "husky",
    "changeset": "changeset",
    "release:status": "changeset status",
    "release:version": "changeset version && pnpm install --lockfile-only && oxfmt .",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.0",
    "husky": "9.1.7",
    "lint-staged": "17.0.5",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "tsx": "4.22.3",
    "turbo": "2.9.14"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern",
    "*.{js,jsx,ts,tsx}": [
      "oxlint --fix --deny-warnings",
      "pnpm --filter @wordclock/react exec vitest related --run"
    ]
  },
  "packageManager": "pnpm@11.22.0"
}
