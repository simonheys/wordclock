{
  "name": "wordclock",
  "version": "1.2.1",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "author": "Simon Heys <si@simonheys.com>",
  "license": "MIT",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "format": "prettier --ignore-unknown --write . && turbo run format",
    "format:check": "prettier --ignore-unknown --check .",
    "build": "turbo run build --filter='!wordclock-macos'",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "CI=true turbo run test --filter='!wordclock-macos'",
    "dev": "turbo run dev",
    "prepare": "husky",
    "publish-npm": "pnpm run -r --parallel --stream publish-npm"
  },
  "devDependencies": {
    "eslint": "9.39.4",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "prettier": "3.8.3",
    "prettier-plugin-organize-imports": "4.3.0",
    "tsx": "4.21.0",
    "turbo": "2.9.10"
  },
  "lint-staged": {
    "*": "prettier --ignore-unknown --write",
    "*.{js,jsx,ts,tsx}": [
      "eslint --cache --fix",
      "pnpm --filter @simonheys/wordclock exec vitest related --run"
    ]
  }
}
